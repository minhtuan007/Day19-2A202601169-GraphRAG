# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# --- LLM-as-a-Judge (OpenRouter free router) ---
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=openrouter/free
OPENROUTER_API_KEY=sk-or-v1-...

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
